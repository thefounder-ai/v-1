# Application
APP_ENV=development
APP_NAME=SkillOrbit

# Supabase (added in Phase 2)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Qdrant (added in Phase 6)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=skillorbit_products

# Mesh API (mandatory for AI features, added in Phase 6)
MESH_API_KEY=
MESH_API_BASE_URL=https://api.meshapi.ai/v1
MESH_EMBEDDING_MODEL=cohere/embed-english-v3
MESH_CHAT_MODEL=openai/gpt-4.1-mini

# Resend (Phase 11; required only for explicit email delivery)
RESEND_API_KEY=
RESEND_FROM_EMAIL=SkillOrbit <hello@plyndrox.app>
APP_PUBLIC_URL=http://localhost:5000

# Weekly digest cron (cron-job.org / UptimeRobot + external trigger)
CRON_SECRET=change-me-to-a-long-random-string
DIGEST_INTERVAL_DAYS=7

# Demo seeding (scripts/demo_seed.py --apply)
DEMO_USER_EMAIL=