# Application
APP_ENV=development
APP_NAME=SkillOrbit
APP_PUBLIC_URL=http://localhost:5000

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=skillorbit_products

# Mesh API (mandatory — all LLM and embedding calls)
MESH_API_KEY=
MESH_API_BASE_URL=https://api.meshapi.ai/v1
MESH_EMBEDDING_MODEL=cohere/embed-english-v3
MESH_CHAT_MODEL=openai/gpt-4.1-mini

# Email (optional — manual send + weekly digest)
RESEND_API_KEY=
RESEND_FROM_EMAIL=SkillOrbit <hello@plyndrox.app>

# Weekly digest cron
CRON_SECRET=change-me-to-a-long-random-string
DIGEST_INTERVAL_DAYS=7

# Demo seeding (scripts/demo_seed.py --apply)
DEMO_USER_EMAIL=
