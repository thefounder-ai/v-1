# =============================================================================
# SkillOrbit — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (macOS / Linux)
#
# Never commit .env to git — it is listed in .gitignore.
# Full architecture reference: ARCHITECTURE.md
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# APP_ENV controls cookie security and scheduler behaviour.
# Use "development" locally, "production" on Render.
APP_ENV=development

# Display name shown in emails and UI.
APP_NAME=SkillOrbit

# Public URL of your deployed app (used in email links and share paths).
# Local:  http://localhost:5000
# Prod:   https://v-1-ora9.onrender.com
APP_PUBLIC_URL=http://localhost:5000


# -----------------------------------------------------------------------------
# Supabase (required)
# -----------------------------------------------------------------------------
# Project URL and anon key — found in Supabase → Settings → API.
# Powers: auth, profiles, activity events, recommendations, bookmarks.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Service role key — bypasses Row Level Security.
# Required for: weekly digest, admin demo seed, share-path lookups.
# Found in Supabase → Settings → API → service_role (keep secret).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# -----------------------------------------------------------------------------
# Qdrant (required for semantic search + RAG)
# -----------------------------------------------------------------------------
# Cloud cluster URL and API key from https://cloud.qdrant.io
QDRANT_URL=https://your-cluster.region.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# Collection name for product vectors (default is fine).
QDRANT_COLLECTION=skillorbit_products


# -----------------------------------------------------------------------------
# Mesh API (required — mandatory for hackathon)
# -----------------------------------------------------------------------------
# All LLM and embedding calls go through Mesh API.
# Get your key (starts with rsk_) at https://developers.meshapi.ai
MESH_API_KEY=rsk_your-mesh-api-key

# OpenAI-compatible base URL — do not change unless Mesh docs say so.
MESH_API_BASE_URL=https://api.meshapi.ai/v1

# Embedding model used when indexing catalog products into Qdrant.
MESH_EMBEDDING_MODEL=cohere/embed-english-v3

# Chat model used for recommendation narratives and change explanations.
MESH_CHAT_MODEL=openai/gpt-4.1-mini


# -----------------------------------------------------------------------------
# Resend — Email delivery (optional)
# -----------------------------------------------------------------------------
# Required for "Email me this path" and weekly digest emails.
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key

# Sender address — must be a verified domain in Resend.
RESEND_FROM_EMAIL=SkillOrbit <hello@yourdomain.com>


# -----------------------------------------------------------------------------
# Weekly digest scheduler (optional)
# -----------------------------------------------------------------------------
# Long random string to protect the external cron endpoint.
# Used by: GET /api/cron/weekly-digest?secret=YOUR_CRON_SECRET
CRON_SECRET=change-me-to-a-long-random-string

# Days between weekly digest emails (default: 7).
DIGEST_INTERVAL_DAYS=7


# -----------------------------------------------------------------------------
# Demo & testing (optional — local / CI only)
# -----------------------------------------------------------------------------
# Email of the demo learner account for scripts/demo_seed.py --apply
# and the Admin → Seed demo activity button.
DEMO_USER_EMAIL=demo@example.com

# Credentials for scripts/local_e2e.py (skip auto-signup if set).
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=


# -----------------------------------------------------------------------------
# GitHub Actions secrets (not .env — set in repo Settings → Secrets)
# -----------------------------------------------------------------------------
# MESH_API_KEY        — same key as above (used by SmartReco Checks CI)
# SUBMISSION_TOKEN    — from Krishnaik hackathon dashboard
